# Copy this file to `.env` (or export the variables) before running.
# All values are safe defaults; there are no secrets in this application.

# Bind address. Use 0.0.0.0 to listen on all interfaces.
BIND_HOST=0.0.0.0

# TCP port the HTTP server listens on.
PORT=8080

# Base directory for persistent data (SQLite file lives here).
DATA_DIR=./data

# Full SQLite database path. Overrides DATA_DIR when set.
# DATABASE_PATH=./data/taskboard.db

# Non-sensitive release marker served by /api/meta. Defaults to the git
# short SHA written by scripts/build.sh into VERSION.
# BUILD_MARKER=v1.0.0